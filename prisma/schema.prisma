// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CashbackRule {
  id                 String   @id @default(cuid())
  shop               String
  name               String   @default("Order cashback")
  active             Boolean  @default(false)
  cashbackBasisPoints Int     @default(1000)
  eligibleCustomerTag String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop, active])
}

model CashbackOrder {
  id                     String   @id @default(cuid())
  shop                   String
  orderGid               String
  customerGid            String
  currencyCode           String
  currencyExponent       Int
  merchandiseBasisMinor  BigInt
  cashbackMinor          BigInt
  refundedBasisMinor     BigInt   @default(0)
  reversedMinor          BigInt   @default(0)
  lineItemsJson          String
  refundedLinesJson      String   @default("{}")
  status                 String   @default("PENDING")
  shopifyTransactionGid  String?
  processingRefundKey   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([shop, orderGid])
  @@index([shop, customerGid])
}

model CreditLedgerEntry {
  id                    String   @id @default(cuid())
  shop                  String
  customerGid           String
  accountGid            String?
  transactionGid        String?
  orderGid              String?
  refundGid             String?
  kind                  String
  status                String   @default("PENDING")
  amountMinor           BigInt
  currencyCode          String
  currencyExponent      Int
  reason                String
  actor                 String?
  idempotencyKey        String
  balanceAfterMinor     BigInt?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([shop, idempotencyKey])
  @@index([shop, customerGid, createdAt])
  @@index([shop, orderGid])
}

model WebhookReceipt {
  id          String   @id @default(cuid())
  shop        String
  webhookId   String
  topic       String
  status      String   @default("PROCESSING")
  error       String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@unique([shop, webhookId])
  @@index([shop, topic, createdAt])
}
